# Clerk (required for auth; see .env.production.example for test keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_key_here
CLERK_SECRET_KEY=sk_test_your_key_here

# Paddle Billing Configuration (v2)
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_client_token_here
NEXT_PUBLIC_PADDLE_SANDBOX=true

# Backend API (should point to the base URL, NOT including /api)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional: canonical URL for OG metadata
NEXT_PUBLIC_SITE_URL=http://localhost:3000
