# TeamOS Frontend - Production Environment Template

# The public URL of the Django REST Framework API
# Example: https://api.teamos.io/api
NEXT_PUBLIC_API_URL=https://your-backend-domain.com/api

# The WebSockets URL for presence and chat
# Example: wss://api.teamos.io/ws
NEXT_PUBLIC_WS_URL=wss://your-backend-domain.com/ws
