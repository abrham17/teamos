# TeamOS MCP Gateway — Environment Variables
# Copy this to .env and fill in your credentials.
# Only set the services you actually use; others will show a warning but won't crash.

# ─── Optional: shared secret between Django and the gateway ───────────────────
# If set, Django must send "Authorization: Bearer <this value>" to the gateway.
# Set the same value as MCP_GATEWAY_AUTH_TOKEN in backend/.env
# GATEWAY_AUTH_TOKEN=change_me_to_a_random_secret

# ─── GitHub ───────────────────────────────────────────────────────────────────
# Create at: https://github.com/settings/tokens
# Required scopes: repo, issues, pull_requests, read:user
# GITHUB_TOKEN=ghp_...

# ─── Slack ────────────────────────────────────────────────────────────────────
# Create a Slack App at: https://api.slack.com/apps
# Required scopes: channels:history, channels:read, chat:write, users:read
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_TEAM_ID=T...

# ─── Trello ───────────────────────────────────────────────────────────────────
# Get key + token at: https://trello.com/app-key
# TRELLO_API_KEY=...
# TRELLO_TOKEN=...

# ─── Notion ───────────────────────────────────────────────────────────────────
# Create an integration at: https://www.notion.so/my-integrations
# NOTION_TOKEN=secret_...

# ─── Google Drive & Calendar ──────────────────────────────────────────────────
# Create OAuth2 credentials at: https://console.cloud.google.com/apis/credentials
# Enable: Google Drive API, Google Calendar API
# Set Authorized redirect URI: http://localhost:3000
# After OAuth flow, paste your refresh token below.
# GOOGLE_CLIENT_ID=....apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-...
# GOOGLE_REFRESH_TOKEN=1//...
