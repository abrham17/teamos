      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Serif:ital,wght@0,400;1,400&family=DM+Mono:ital,wght@0,300;0,400;0,500;1,300;1,400;1,500&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont@latest/dist/tabler-icons.min.css');\n\n  :root {\n    --void-black: #0a0a0f;\n    --slate-surface: #1c1c28;\n    --electric-violet: #8b7ff4;\n    --text-dim: #6b6b85;\n  }\n\n  body {\n    background-color: var(--void-black);\n    color: white;\n    font-family: 'DM Sans', sans-serif;\n    margin: 0;\n    overflow-x: hidden;\n  }\n\n  .font-serif {\n    font-family: 'Instrument Serif', serif;\n  }\n\n  .font-mono {\n    font-family: 'DM Mono', monospace;\n  }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 4px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: rgba(139, 127, 244, 0.2);\n    border-radius: 10px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n    background: rgba(139, 127, 244, 0.4);\n  }\n\n  .glow-text {\n    text-shadow: 0 0 10px rgba(139, 127, 244, 0.5);\n  }\n\n  .glow-border {\n    box-shadow: 0 0 15px rgba(139, 127, 244, 0.2);\n  }\n\n  .edge-shimmer {\n    position: relative;\n    overflow: hidden;\n  }\n  .edge-shimmer::after {\n    content: '';\n    position: absolute;\n    top: 0;\n    left: -100%;\n    width: 50%;\n    height: 100%;\n    background: linear-gradient(90deg, transparent, rgba(139, 127, 244, 0.1), transparent);\n    animation: shimmer 3s infinite;\n  }\n\n  @keyframes shimmer {\n    100% {\n      left: 200%;\n    }\n  }\n\n  @keyframes pulse-violet {\n    0%, 100% { transform: scale(1); opacity: 1; box-shadow: 0 0 20px rgba(139, 127, 244, 0.4); }\n    50% { transform: scale(1.05); opacity: 0.8; box-shadow: 0 0 40px rgba(139, 127, 244, 0.6); }\n  }\n\n  .animate-pulse-violet {\n    animation: pulse-violet 3s ease-in-out infinite;\n  }\n\n  .glowing-divider {\n    border-bottom: 1px solid transparent;\n    border-image: linear-gradient(to right, transparent, rgba(139, 127, 244, 0.4), transparent) 1;\n    position: relative;\n  }\n  .glowing-divider::after {\n    content: '';\n    position: absolute;\n    bottom: -1px;\n    left: 20%;\n    right: 20%;\n    height: 1px;\n    background: var(--electric-violet);\n    box-shadow: 0 0 10px var(--electric-violet), 0 0 20px var(--electric-violet);\n    opacity: 0.15;\n  }\n\n  @keyframes scanline {\n    0% { transform: translateY(-100%); }\n    100% { transform: translateY(1000%); }\n  }\n\n  .scanline {\n    position: absolute;\n    top: 0;\n    left: 0;\n    width: 100%;\n    height: 100px;\n    background: linear-gradient(to bottom, transparent, rgba(139, 127, 244, 0.05), transparent);\n    animation: scanline 8s linear infinite;\n    pointer-events: none;\n    z-index: 15;\n  }\n\n  @keyframes float-node {\n    0%, 100% { transform: translate(-50%, -50%) translateY(0); }\n    50% { transform: translate(-50%, -52%) translateY(-10px); }\n  }\n\n  .animate-float {\n    animation: float-node 4s ease-in-out infinite;\n  }\n\n  .dot-matrix {\n    background-image: radial-gradient(rgba(139, 127, 244, 0.1) 1px, transparent 1px);\n    background-size: 20px 20px;\n  }\n</style>\n\n<div class=\"w-full flex justify-center bg-[#050508] min-h-[900px]\" data-kid=\"1\">\n  <div class=\"w-full max-w-[1440px] flex h-[900px] overflow-hidden border border-white/10 shadow-2xl relative\" data-kid=\"2\">\n    \n    \n    <div class=\"w-[60%] flex flex-col bg-[#0a0a0f] border-r border-white/5 relative z-20\" data-kid=\"3\">\n      \n      <div class=\"h-20 flex items-center justify-between px-8 border-b border-white/5 bg-[#0a0a0f]/80 backdrop-blur-md\" data-kid=\"4\">\n        <div class=\"flex items-center gap-4\" data-kid=\"5\">\n          <div class=\"w-10 h-10 rounded-xl bg-[#8b7ff4]/10 border border-[#8b7ff4]/20 flex items-center justify-center shadow-[0_0_15px_rgba(139,127,244,0.15)]\" data-kid=\"6\">\n            <i class=\"ti ti-terminal-2 text-[#8b7ff4] text-2xl\" data-kid=\"7\"></i>\n          </div>\n          <h1 class=\"text-2xl font-serif text-white tracking-tight\" data-kid=\"8\">Teamos <span class=\"text-[#8b7ff4] glow-text\" data-kid=\"9\">Terminal</span></h1>\n          <div class=\"flex items-center gap-2 px-2 py-0.5 rounded bg-emerald-500/10 border border-emerald-500/20 ml-2\" data-kid=\"10\">\n            <span class=\"w-1.5 h-1.5 rounded-full bg-emerald-500 animate-pulse\" data-kid=\"11\"></span>\n            <span class=\"text-[9px] font-mono text-emerald-500 uppercase tracking-tighter\" data-kid=\"12\">LAT-01: ONLINE</span>\n          </div>\n        </div>\n        <div class=\"flex items-center gap-2 text-white/40\" data-kid=\"13\">\n          <button class=\"p-2 hover:text-[#8b7ff4] transition-colors\" data-kid=\"14\"><i class=\"ti ti-settings\" data-kid=\"15\"></i></button>\n          <button class=\"p-2 hover:text-[#8b7ff4] transition-colors\" data-kid=\"16\"><i class=\"ti ti-dots-vertical\" data-kid=\"17\"></i></button>\n        </div>\n      </div>\n\n      \n      <div class=\"flex-1 overflow-y-auto custom-scrollbar p-0\" data-kid=\"18\">\n        \n        <div class=\"py-12 px-12 glowing-divider hover:bg-white/[0.02] transition-all relative group\" data-kid=\"19\">\n          <div class=\"absolute left-0 top-0 bottom-0 w-0.5 bg-[#8b7ff4] opacity-0 group-hover:opacity-100 transition-opacity shadow-[0_0_10px_#8b7ff4]\" data-kid=\"20\"></div>\n          <div class=\"flex gap-8\" data-kid=\"21\">\n            <div class=\"w-10 h-10 rounded bg-[#8b7ff4]/10 border border-[#8b7ff4]/20 flex-shrink-0 flex items-center justify-center\" data-kid=\"22\">\n              <i class=\"ti ti-sparkles text-[#8b7ff4]\" data-kid=\"23\"></i>\n            </div>\n            <div class=\"flex-1 space-y-4\" data-kid=\"24\">\n              <div class=\"flex items-center gap-3\" data-kid=\"25\">\n                <span class=\"text-[10px] font-mono text-[#8b7ff4] uppercase tracking-widest font-bold\" data-kid=\"26\">Lattice AI Intelligence</span>\n                <span class=\"text-[10px] font-mono text-white/20\" data-kid=\"27\">0.42s latency</span>\n              </div>\n              <div class=\"space-y-4\" data-kid=\"28\">\n                <p class=\"text-white/90 text-base leading-relaxed font-sans\" data-kid=\"29\">\n                  The dependency mapping for <span class=\"text-[#8b7ff4] underline decoration-dotted underline-offset-4\" data-kid=\"30\">Lattice Expansion</span> is complete. \n                  I've detected a significant cluster intersection within the <span class=\"text-white font-medium italic\" data-kid=\"31\">Semantic Core</span>.\n                </p>\n                <div class=\"grid grid-cols-2 gap-4 pt-2\" data-kid=\"32\">\n                  <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 space-y-1\" data-kid=\"33\">\n                    <p class=\"text-[10px] font-mono text-white/40 uppercase\" data-kid=\"34\">Cluster Density</p>\n                    <p class=\"text-2xl font-serif text-white\" data-kid=\"35\">0.942</p>\n                  </div>\n                  <div class=\"p-4 rounded-xl bg-white/[0.03] border border-white/5 space-y-1\" data-kid=\"36\">\n                    <p class=\"text-[10px] font-mono text-white/40 uppercase\" data-kid=\"37\">Orphan Nodes</p>\n                    <p class=\"text-2xl font-serif text-[#8b7ff4]\" data-kid=\"38\">12</p>\n                  </div>\n                </div>\n              </div>\n            </div>\n          </div>\n        </div>\n\n        \n        <div class=\"py-12 px-12 glowing-divider hover:bg-white/[0.02] transition-all relative group\" data-kid=\"39\">\n          <div class=\"flex gap-8\" data-kid=\"40\">\n            <div class=\"w-10 h-10 rounded bg-white/5 border border-white/10 flex-shrink-0 flex items-cent