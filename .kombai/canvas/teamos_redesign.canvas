      "html": "\n<style data-kid=\"0\">\n  @import url('https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,100..1000;1,9..40,100..1000&family=Instrument+Serif:ital,wght@0,400;1,400&display=swap');\n  @import url('https://cdn.jsdelivr.net/npm/@tabler/icons-webfont/tabler-icons.min.css');\n\n  :root {\n    --bg-main: #f5f4f8;\n    --accent: #6c5ce7;\n    --accent-light: #8b7ff4;\n    --glass: rgba(255, 255, 255, 0.65);\n    --glass-heavy: rgba(255, 255, 255, 0.85);\n    --glass-border: rgba(255, 255, 255, 0.5);\n    --text-primary: #0a0a0f;\n    --text-secondary: #3d3d55;\n    --text-muted: #7a7a95;\n    --radius-lg: 24px;\n    --radius-md: 16px;\n    --font-sans: 'DM Sans', sans-serif;\n    --font-serif: 'Instrument Serif', serif;\n  }\n\n  body {\n    background-color: var(--bg-main);\n    color: var(--text-primary);\n    font-family: var(--font-sans);\n    margin: 0;\n    padding: 0;\n  }\n\n  .mesh-grid {\n    position: absolute;\n    inset: 0;\n    z-index: 0;\n    background-image: \n      radial-gradient(circle at 2px 2px, rgba(108, 92, 231, 0.08) 1px, transparent 0);\n    background-size: 24px 24px;\n    pointer-events: none;\n  }\n\n  .ambient-glow {\n    position: absolute;\n    width: 600px;\n    height: 600px;\n    background: radial-gradient(circle, rgba(108, 92, 231, 0.03) 0%, transparent 70%);\n    border-radius: 50%;\n    filter: blur(60px);\n    z-index: 0;\n    pointer-events: none;\n  }\n\n  .glass-panel {\n    background: var(--glass);\n    backdrop-filter: blur(24px);\n    -webkit-backdrop-filter: blur(24px);\n    border: 1px solid var(--glass-border);\n    box-shadow: 0 8px 32px 0 rgba(31, 38, 135, 0.04);\n  }\n\n  .glass-heavy {\n    background: var(--glass-heavy);\n    backdrop-filter: blur(30px);\n    border: 1px solid var(--glass-border);\n  }\n\n  .scanline {\n    position: relative;\n    overflow: hidden;\n  }\n  .scanline::after {\n    content: \"\";\n    position: absolute;\n    inset: 0;\n    background: linear-gradient(rgba(108, 92, 231, 0.03) 50%, transparent 50%);\n    background-size: 100% 4px;\n    pointer-events: none;\n    opacity: 0.5;\n  }\n\n  .font-serif { font-family: var(--font-serif); }\n  .font-sans { font-family: var(--font-sans); }\n\n  .custom-scrollbar::-webkit-scrollbar {\n    width: 6px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-track {\n    background: transparent;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb {\n    background: rgba(108, 92, 231, 0.1);\n    border-radius: 10px;\n  }\n  .custom-scrollbar::-webkit-scrollbar-thumb:hover {\n    background: rgba(108, 92, 231, 0.25);\n  }\n\n  /* Animations */\n  @keyframes slideUp {\n    from { opacity: 0; transform: translateY(10px); }\n    to { opacity: 1; transform: translateY(0); }\n  }\n  .animate-slide-up {\n    animation: slideUp 0.4s ease-out forwards;\n  }\n\n  .active-indicator {\n    position: relative;\n  }\n  .active-indicator::after {\n    content: '';\n    position: absolute;\n    left: -12px;\n    top: 50%;\n    transform: translateY(-50%);\n    width: 4px;\n    height: 16px;\n    background: var(--accent);\n    border-radius: 99px;\n  }\n</style>\n\n<div class=\"relative w-full h-[1100px] flex mesh-grid select-none\" data-kid=\"1\">\n  \n  <aside class=\"w-[280px] h-full glass-panel border-r border-white/40 flex flex-col z-10\" data-kid=\"2\">\n    <div class=\"p-6 pb-2\" data-kid=\"3\">\n      <div class=\"flex items-center gap-3 mb-8\" data-kid=\"4\">\n        <div class=\"w-10 h-10 rounded-xl bg-[var(--accent)] flex items-center justify-center text-white shadow-lg shadow-[var(--accent)]/30\" data-kid=\"5\">\n          <i class=\"ti ti-cpu text-2xl\" data-kid=\"6\"></i>\n        </div>\n        <h1 class=\"font-serif text-2xl leading-none\" data-kid=\"7\">Command</h1>\n      </div>\n      \n      <button class=\"w-full flex items-center justify-center gap-2 bg-white/80 hover:bg-white border border-[var(--accent)]/10 text-[var(--text-primary)] font-medium py-3 rounded-xl transition-all shadow-sm mb-6 group\" data-kid=\"8\">\n        <i class=\"ti ti-plus text-lg transition-transform group-hover:rotate-90\" data-kid=\"9\"></i>\n        <span data-kid=\"10\">New Operation</span>\n      </button>\n\n      <div class=\"relative mb-4\" data-kid=\"11\">\n        <i class=\"ti ti-search absolute left-3 top-1/2 -translate-y-1/2 text-[var(--text-muted)]\" data-kid=\"12\"></i>\n        <input type=\"text\" placeholder=\"Search archive...\" class=\"w-full bg-white/40 border border-white/50 rounded-lg py-2 pl-10 pr-4 text-sm outline-none focus:border-[var(--accent)]/30 transition-all placeholder:text-[var(--text-muted)]/60\" data-kid=\"13\">\n      </div>\n    </div>\n\n    <div class=\"flex-1 overflow-y-auto custom-scrollbar px-4 space-y-1\" data-kid=\"14\">\n      <div class=\"px-2 py-4\" data-kid=\"15\">\n        <p class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--text-muted)]/60 mb-3 px-2\" data-kid=\"16\">Recently Active</p>\n        \n        \n        <div class=\"group relative px-3 py-3 rounded-xl bg-[var(--accent)]/5 border border-[var(--accent)]/10 mb-1 active-indicator\" data-kid=\"17\">\n          <div class=\"flex items-center justify-between mb-1\" data-kid=\"18\">\n            <span class=\"text-xs font-semibold text-[var(--accent)]\" data-kid=\"19\">Current Session</span>\n            <span class=\"text-[9px] font-medium text-[var(--accent)]/60\" data-kid=\"20\">2m ago</span>\n          </div>\n          <p class=\"text-sm font-medium text-[var(--text-primary)] truncate\" data-kid=\"21\">Infrastructure Alignment: Orion Roadmap</p>\n        </div>\n\n        \n        <div class=\"group px-3 py-3 rounded-xl hover:bg-white/50 transition-all cursor-pointer\" data-kid=\"22\">\n          <div class=\"flex items-center justify-between mb-1\" data-kid=\"23\">\n            <span class=\"text-xs font-medium text-[var(--text-muted)]\" data-kid=\"24\">Archive</span>\n            <span class=\"text-[9px] font-medium text-[var(--text-muted)]/50\" data-kid=\"25\">1h ago</span>\n          </div>\n          <p class=\"text-sm font-medium text-[var(--text-secondary)] truncate\" data-kid=\"26\">Competitive Workspace Analysis</p>\n        </div>\n\n        <div class=\"group px-3 py-3 rounded-xl hover:bg-white/50 transition-all cursor-pointer\" data-kid=\"27\">\n          <div class=\"flex items-center justify-between mb-1\" data-kid=\"28\">\n            <span class=\"text-xs font-medium text-[var(--text-muted)]\" data-kid=\"29\">Archive</span>\n            <span class=\"text-[9px] font-medium text-[var(--text-muted)]/50\" data-kid=\"30\">Yesterday</span>\n          </div>\n          <p class=\"text-sm font-medium text-[var(--text-secondary)] truncate\" data-kid=\"31\">API Gateway Documentation Sync</p>\n        </div>\n      </div>\n\n      <div class=\"px-2 py-4\" data-kid=\"32\">\n        <p class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--text-muted)]/60 mb-3 px-2\" data-kid=\"33\">Folders</p>\n        <div class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/40 text-sm text-[var(--text-secondary)] cursor-pointer\" data-kid=\"34\">\n          <i class=\"ti ti-folder text-[var(--accent)]\" data-kid=\"35\"></i>\n          <span data-kid=\"36\">Strategic Research</span>\n        </div>\n        <div class=\"flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-white/40 text-sm text-[var(--text-secondary)] cursor-pointer\" data-kid=\"37\">\n          <i class=\"ti ti-folder text-[var(--accent)]\" data-kid=\"38\"></i>\n          <span data-kid=\"39\">Technical Audits</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"p-6 mt-auto border-t border-white/40\" data-kid=\"40\">\n      <div class=\"flex items-center gap-3 p-2 rounded-xl hover:bg-white/60 transition-all cursor-pointer\" data-kid=\"41\">\n        <img src=\"https://i.pravatar.cc/100?u=sarah\" alt=\"User\" class=\"w-8 h-8 rounded-lg shadow-sm\" data-kid=\"42\">\n        <div class=\"flex-1 min-w-0\" data-kid=\"43\">\n          <p class=\"text-sm font-bold text-[var(--text-primary)] truncate leading-none mb-1\" data-kid=\"44\">Sarah Chen</p>\n          <p class=\"text-[10px] text-[var(--text-muted)] uppercase tracking-wider\" data-kid=\"45\">Commander</p>\n        </div>\n        <i class=\"ti ti-settings text-lg text-[var(--text-muted)]\" data-kid=\"46\"></i>\n      </div>\n    </div>\n  </aside>\n\n  \n  <main class=\"flex-1 h-full flex flex-col relative z-0\" data-kid=\"47\">\n    \n    <div class=\"ambient-glow top-20 left-1/4\" data-kid=\"48\"></div>\n    <div class=\"ambient-glow bottom-20 right-1/4\" data-kid=\"49\"></div>\n\n    \n    <header class=\"h-[72px] glass-panel border-b border-white/40 flex items-center justify-between px-8 shrink-0 relative z-10\" data-kid=\"50\">\n      <div class=\"flex flex-col\" data-kid=\"51\">\n        <h2 class=\"font-serif text-2xl text-[var(--text-primary)] leading-tight\" data-kid=\"52\">Infrastructure Alignment: Orion</h2>\n        <div class=\"flex items-center gap-3 mt-0.5\" data-kid=\"53\">\n          <div class=\"flex items-center gap-1.5\" data-kid=\"54\">\n            <span class=\"flex h-1.5 w-1.5 rounded-full bg-[var(--accent)] animate-pulse\" data-kid=\"55\"></span>\n            <span class=\"text-[10px] font-bold text-[var(--accent)] uppercase tracking-widest\" data-kid=\"56\">Active Processing</span>\n          </div>\n          <span class=\"text-[10px] text-[var(--text-muted)] opacity-30\" data-kid=\"57\">|</span>\n          <div class=\"flex items-center gap-1\" data-kid=\"58\">\n            <i class=\"ti ti-activity text-[var(--text-muted)] text-[10px]\" data-kid=\"59\"></i>\n            <span class=\"text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-widest\" data-kid=\"60\">Latency: 12ms</span>\n          </div>\n        </div>\n      </div>\n      \n      <div class=\"flex items-center gap-4\" data-kid=\"61\">\n        <div class=\"flex -space-x-2\" data-kid=\"62\">\n          <img src=\"https://i.pravatar.cc/100?u=dev1\" class=\"w-8 h-8 rounded-full border-2 border-white\" data-kid=\"63\">\n          <img src=\"https://i.pravatar.cc/100?u=dev2\" class=\"w-8 h-8 rounded-full border-2 border-white\" data-kid=\"64\">\n          <div class=\"w-8 h-8 rounded-full border-2 border-white bg-[var(--accent)]/10 flex items-center justify-center text-[10px] font-bold text-[var(--accent)]\" data-kid=\"65\">+3</div>\n        </div>\n        <div class=\"h-6 w-[1px] bg-white/40 mx-2\" data-kid=\"66\"></div>\n        <button class=\"p-2.5 rounded-xl hover:bg-white/60 transition-all text-[var(--text-secondary)]\" data-kid=\"67\">\n          <i class=\"ti ti-share-2 text-xl\" data-kid=\"68\"></i>\n        </button>\n        <button class=\"p-2.5 rounded-xl hover:bg-white/60 transition-all text-[var(--text-secondary)]\" data-kid=\"69\">\n          <i class=\"ti ti-dots-vertical text-xl\" data-kid=\"70\"></i>\n        </button>\n      </div>\n    </header>\n\n    \n    <div class=\"flex-1 overflow-y-auto custom-scrollbar px-12 pt-10 pb-40 space-y-12\" data-kid=\"71\">\n      \n      <div class=\"flex justify-end animate-slide-up\" style=\"animation-delay: 0.1s;\" data-kid=\"72\">\n        <div class=\"max-w-[70%] space-y-2\" data-kid=\"73\">\n          <div class=\"flex items-center justify-end gap-2 mb-1\" data-kid=\"74\">\n            <span class=\"text-[10px] font-bold text-[var(--text-muted)]/60 uppercase tracking-widest\" data-kid=\"75\">Commander Sarah</span>\n            <span class=\"text-[9px] text-[var(--text-muted)]/40\" data-kid=\"76\">10:42 AM</span>\n          </div>\n          <div class=\"glass-heavy shadow-soft rounded-[28px] rounded-tr-[4px] px-6 py-4\" data-kid=\"77\">\n            <p class=\"text-[15px] text-[var(--text-secondary)] leading-relaxed\" data-kid=\"78\">\n              Analyze the relationship between the <span class=\"text-[var(--accent)] font-semibold underline decoration-[var(--accent)]/20 underline-offset-4\" data-kid=\"79\">Project Orion</span> roadmap and our current <span class=\"text-[var(--accent)] font-semibold underline decoration-[var(--accent)]/20 underline-offset-4\" data-kid=\"80\">Q3 Infrastructure</span> constraints. Identify any high-risk dependencies.\n            </p>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"flex gap-6 animate-slide-up\" style=\"animation-delay: 0.3s;\" data-kid=\"81\">\n        <div class=\"shrink-0 pt-8\" data-kid=\"82\">\n          <div class=\"w-12 h-12 rounded-2xl bg-[var(--accent)] flex items-center justify-center text-white shadow-xl shadow-[var(--accent)]/20\" data-kid=\"83\">\n            <i class=\"ti ti-cpu text-2xl\" data-kid=\"84\"></i>\n          </div>\n        </div>\n        <div class=\"max-w-[85%] space-y-4\" data-kid=\"85\">\n          <div class=\"flex items-center justify-between w-full mb-1\" data-kid=\"86\">\n            <div class=\"flex items-center gap-3\" data-kid=\"87\">\n              <span class=\"text-[10px] font-bold text-[var(--accent)] uppercase tracking-widest\" data-kid=\"88\">Command Intelligence</span>\n              <div class=\"flex gap-1\" data-kid=\"89\">\n                <span class=\"px-1.5 py-0.5 rounded bg-[var(--accent)]/5 text-[9px] font-bold text-[var(--accent)] border border-[var(--accent)]/10 uppercase tracking-tighter\" data-kid=\"90\">Research Mode</span>\n                <span class=\"px-1.5 py-0.5 rounded bg-emerald-500/5 text-[9px] font-bold text-emerald-600 border border-emerald-500/10 uppercase tracking-tighter\" data-kid=\"91\">Graph Linked</span>\n              </div>\n            </div>\n            <div class=\"flex items-center gap-2 bg-white/40 px-2 py-0.5 rounded-lg border border-white/60\" data-kid=\"92\">\n              <span class=\"text-[9px] font-bold text-[var(--text-muted)] uppercase tracking-widest\" data-kid=\"93\">Confidence</span>\n              <span class=\"text-[9px] font-bold text-emerald-600\" data-kid=\"94\">98.4%</span>\n            </div>\n          </div>\n          \n          <div class=\"glass-panel shadow-soft rounded-[32px] rounded-tl-[4px] px-8 py-7 border-t-white/80\" data-kid=\"95\">\n            <h3 class=\"font-serif text-[28px] text-[var(--text-primary)] mb-4 leading-tight\" data-kid=\"96\">Critical Dependency Conflict: Orion v2.4 vs. Node-7x Decommissioning</h3>\n            \n            <div class=\"font-sans text-[15px] text-[var(--text-secondary)] leading-relaxed space-y-5\" data-kid=\"97\">\n              <p data-kid=\"98\">My cross-referencing of the <span class=\"italic\" data-kid=\"99\">Knowledge Graph</span> indicates a critical path conflict in late August. The <span class=\"font-bold text-[var(--text-primary)]\" data-kid=\"100\">Project Orion</span> v2.4 rollout requires three synchronized compute clusters for high-fidelity rendering, which are currently mapped to legacy infrastructure.</p>\n              \n              \n              <div class=\"flex flex-wrap gap-2 py-2\" data-kid=\"101\">\n                <div class=\"group flex items-center gap-2.5 bg-white/60 border border-white/80 hover:border-[var(--accent)]/30 hover:bg-white px-4 py-2 rounded-2xl transition-all cursor-pointer shadow-sm\" data-kid=\"102\">\n                  <div class=\"w-6 h-6 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center text-[var(--accent)]\" data-kid=\"103\">\n                    <i class=\"ti ti-share-2 text-sm\" data-kid=\"104\"></i>\n                  </div>\n                  <span class=\"text-xs font-bold text-[var(--text-primary)]\" data-kid=\"105\">Orion Roadmap</span>\n                </div>\n                <div class=\"group flex items-center gap-2.5 bg-white/60 border border-white/80 hover:border-[var(--accent)]/30 hover:bg-white px-4 py-2 rounded-2xl transition-all cursor-pointer shadow-sm\" data-kid=\"106\">\n                  <div class=\"w-6 h-6 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center text-[var(--accent)]\" data-kid=\"107\">\n                    <i class=\"ti ti-database text-sm\" data-kid=\"108\"></i>\n                  </div>\n                  <span class=\"text-xs font-bold text-[var(--text-primary)]\" data-kid=\"109\">Q3 Infra Audit</span>\n                </div>\n                <div class=\"group flex items-center gap-2.5 bg-white/60 border border-white/80 hover:border-[var(--accent)]/30 hover:bg-white px-4 py-2 rounded-2xl transition-all cursor-pointer shadow-sm\" data-kid=\"110\">\n                  <div class=\"w-6 h-6 rounded-lg bg-[var(--accent)]/10 flex items-center justify-center text-[var(--accent)]\" data-kid=\"111\">\n                    <i class=\"ti ti-alert-triangle text-sm text-amber-500\" data-kid=\"112\"></i>\n                  </div>\n                  <span class=\"text-xs font-bold text-[var(--text-primary)]\" data-kid=\"113\">Cluster Latency Logs</span>\n                </div>\n              </div>\n\n              <div class=\"scanline bg-gradient-to-br from-white/60 to-white/40 border border-white/60 border-l-4 border-l-[var(--accent)] p-6 rounded-r-2xl space-y-3 shadow-sm min-h-[100px]\" data-kid=\"114\">\n                <div class=\"flex items-center justify-between\" data-kid=\"115\">\n                  <div class=\"flex items-center gap-2\" data-kid=\"116\">\n                    <i class=\"ti ti-bulb text-[var(--accent)] text-sm animate-pulse\" data-kid=\"117\"></i>\n                    <p class=\"text-[10px] font-black uppercase tracking-[0.2em] text-[var(--accent)]\" data-kid=\"118\">Command Directive</p>\n                  </div>\n                  <span class=\"text-[9px] font-bold text-[var(--accent)]/40 tabular-nums\" data-kid=\"119\">ID: ORION-RX-99</span>\n                </div>\n                <p class=\"text-[15px] leading-relaxed text-[var(--text-primary)] font-medium\" data-kid=\"120\">Either delay the <span class=\"bg-[var(--accent)]/10 px-1 rounded text-[var(--accent)] font-bold\" data-kid=\"121\">Rendering Phase 3</span> by 14 days or accelerate the <span class=\"bg-[var(--accent)]/10 px-1 rounded text-[var(--accent)] font-bold\" data-kid=\"122\">V-Cloud Migration</span> currently scheduled for September 1st.</p>\n              </div>\n\n              <p data-kid=\"123\">The <span class=\"font-serif italic text-lg text-[var(--text-primary)]\" data-kid=\"124\">Node-7x Cluster</span> is currently reporting 88% capacity utilization, leaving zero headroom for the Orion burst requirements expected on August 15th.</p>\n            </div>\n          </div>\n          \n          \n          <div class=\"flex items-center gap-4 px-2\" data-kid=\"125\">\n            <span class=\"text-[10px] font-bold text-[var(--text-muted)] uppercase tracking-wider\" data-kid=\"126\">Cited Sources:</span>\n            <div class=\"flex gap-2\" data-kid=\"127\">\n              <div class=\"flex items-center gap-1.5 text-[10px] font-bold text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors cursor-pointer\" data-kid=\"128\">\n                <i class=\"ti ti-link text-xs\" data-kid=\"129\"></i>\n                <span data-kid=\"130\">Wiki/Orion-Specs</span>\n              </div>\n              <div class=\"flex items-center gap-1.5 text-[10px] font-bold text-[var(--text-secondary)] hover:text-[var(--accent)] transition-colors cursor-pointer\" data-kid=\"131\">\n                <i class=\"ti ti-link text-xs\" data-kid=\"132\"></i>\n                <span data-kid=\"133\">Slack/#infra-ops-july</span>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    \n    <div class=\"h-[130px] px-12 pb-8 shrink-0 relative flex flex-col items-center justify-end z-10\" data-kid=\"134\">\n      <div class=\"w-full max-w-4xl relative group\" data-kid=\"135\">\n        \n        <div class=\"absolute -top-10 left-6 flex gap-2 opacity-0 group-focus-within:opacity-100 transition-all duration-300 translate-y-2 group-focus-within:translate-y-0 pointer-events-none group-focus-within:pointer-events-auto\" data-kid=\"136\">\n          <span class=\"px-3 py-1 rounded-full bg-white/80 backdrop-blur-sm border border-white text-[10px] font-bold text-[var(--text-muted)] hover:text-[var(--accent)] cursor-pointer shadow-sm\" data-kid=\"137\">/summarize graph</span>\n          <span class=\"px-3 py-1 rounded-full bg-white/80 backdrop-blur-sm border border-white text-[10px] font-bold text-[var(--text-muted)] hover:text-[var(--accent)] cursor-pointer shadow-sm\" data-kid=\"138\">/export-nodes</span>\n          <span class=\"px-3 py-1 rounded-full bg-white/80 backdrop-blur-sm border border-white text-[10px] font-bold text-[var(--text-muted)] hover:text-[var(--accent)] cursor-pointer shadow-sm\" data-kid=\"139\">/visualize conflict</span>\n        </div>\n\n        <div class=\"glass-heavy shadow-2xl shadow-[var(--accent)]/10 rounded-[28px] border border-white p-2 pl-6 flex items-center gap-4 transition-all focus-within:shadow-[var(--accent)]/20 focus-within:border-[var(--accent)]/40\" data-kid=\"140\">\n          <i class=\"ti ti-command text-[var(--text-muted)] text-xl\" data-kid=\"141\"></i>\n          <input type=\"text\" placeholder=\"Initiate command or ask a question...\" class=\"flex-1 bg-transparent border-none outline-none text-base text-[var(--text-primary)] placeholder:text-[var(--text-muted)]/50 py-3\" data-kid=\"142\">\n          \n          <div class=\"flex items-center gap-2 pr-1\" data-kid=\"143\">\n            <button class=\"p-2.5 rounded-xl hover:bg-[var(--accent)]/10 text-[var(--text-muted)] hover:text-[var(--accent)] transition-all\" data-kid=\"144\">\n              <i class=\"ti ti-paperclip text-xl\" data-kid=\"145\"></i>\n            </button>\n            <button class=\"p-2.5 rounded-xl hover:bg-[var(--accent)]/10 text-[var(--text-muted)] hover:text-[var(--accent)] transition-all\" data-kid=\"146\">\n              <i class=\"ti ti-microphone text-xl\" data-kid=\"147\"></i>\n            </button>\n            <button class=\"bg-[var(--accent)] text-white p-3 rounded-2xl shadow-lg shadow-[var(--accent)]/30 hover:scale-105 transition-all active:scale-95\" data-kid=\"148\">\n              <i class=\"ti ti-arrow-up text-xl\" data-kid=\"149\"></i>\n            </button>\n          </div>\n        </div>\n        <div class=\"flex items-center justify-between px-6 mt-3\" data-kid=\"150\">\n          <div class=\"flex items-center gap-1.5\" data-kid=\"151\">\n            <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-500 shadow-[0_0_8px_rgba(16,185,129,0.5)]\" data-kid=\"152\"></div>\n            <span class=\"text-[10px] font-bold text-[var(--text-secondary)] uppercase tracking-widest\" data-kid=\"153\">System Ready</span>\n          </div>\n          <div class=\"flex items-center gap-1.5\" data-kid=\"154\">\n            <kbd class=\"px-1.5 py-0.5 rounded border border-white/60 bg-white/40 text-[9px] font-bold text-[var(--text-secondary)]\" data-kid=\"155\">⌘ + K</kbd>\n            <span class=\"text-[10px] font-medium text-[var(--text-secondary)]\" data-kid=\"156\">for Command Palette</span>\n          </div>\n        </div>\n      </div>\n    </div>\n  </main>\n\n  \n  <aside class=\"w-[340px] h-full glass-panel border-l border-white/40 flex flex-col z-10 shrink-0\" data-kid=\"157\">\n    <div class=\"p-8 pb-4\" data-kid=\"158\">\n      <div class=\"flex items-center justify-between mb-6\" data-kid=\"159\">\n        <h2 class=\"font-serif text-2xl text-[var(--text-primary)]\" data-kid=\"160\">Graph Insights</h2>\n        <div class=\"w-8 h-8 rounded-full bg-[var(--accent)]/10 flex items-center justify-center text-[var(--accent)]\" data-kid=\"161\">\n          <i class=\"ti ti-share-2 text-lg\" data-kid=\"162\"></i>\n        </div>\n      </div>\n\n      <div class=\"p-4 bg-[var(--accent)] rounded-2xl text-white shadow-lg shadow-[var(--accent)]/20 mb-8 relative overflow-hidden group cursor-pointer\" data-kid=\"163\">\n        <div class=\"absolute -right-4 -top-4 w-24 h-24 bg-white/10 rounded-full blur-2xl group-hover:scale-150 transition-transform\" data-kid=\"164\"></div>\n        <p class=\"text-[10px] font-bold uppercase tracking-widest text-white/60 mb-1\" data-kid=\"165\">Active Focus</p>\n        <h3 class=\"text-xl font-serif mb-2 leading-tight\" data-kid=\"166\">Orion System Architecture</h3>\n        <div class=\"flex items-center gap-2 text-[10px] font-bold bg-black/10 w-fit px-2 py-1 rounded-lg\" data-kid=\"167\">\n          <i class=\"ti ti-database\" data-kid=\"168\"></i>\n          <span data-kid=\"169\">1.2GB GRAPH DATA DATA</span>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"flex-1 overflow-y-auto custom-scrollbar px-6 space-y-8\" data-kid=\"170\">\n      \n      <div class=\"px-2\" data-kid=\"171\">\n        <p class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--text-muted)]/60 mb-4 px-2\" data-kid=\"172\">Local Cluster View</p>\n        <div class=\"h-32 bg-white/30 border border-white/50 rounded-2xl relative overflow-hidden flex items-center justify-center\" data-kid=\"173\">\n           <svg class=\"w-full h-full opacity-20\" viewBox=\"0 0 200 100\" data-kid=\"174\">\n             <circle cx=\"100\" cy=\"50\" r=\"3\" fill=\"var(--accent)\" data-kid=\"175\"></circle>\n             <line x1=\"100\" y1=\"50\" x2=\"60\" y2=\"30\" stroke=\"var(--accent)\" stroke-width=\"0.5\" data-kid=\"176\"></line>\n             <line x1=\"100\" y1=\"50\" x2=\"140\" y2=\"30\" stroke=\"var(--accent)\" stroke-width=\"0.5\" data-kid=\"177\"></line>\n             <line x1=\"100\" y1=\"50\" x2=\"100\" y2=\"80\" stroke=\"var(--accent)\" stroke-width=\"0.5\" data-kid=\"178\"></line>\n             <circle cx=\"60\" cy=\"30\" r=\"2\" fill=\"var(--accent)\" data-kid=\"179\"></circle>\n             <circle cx=\"140\" cy=\"30\" r=\"2\" fill=\"var(--accent)\" data-kid=\"180\"></circle>\n             <circle cx=\"100\" cy=\"80\" r=\"2\" fill=\"var(--accent)\" data-kid=\"181\"></circle>\n           </svg>\n           <span class=\"absolute text-[10px] font-bold text-[var(--accent)] uppercase tracking-tighter bg-white/80 px-2 py-0.5 rounded-full border border-[var(--accent)]/10\" data-kid=\"182\">3 nodes active</span>\n        </div>\n      </div>\n      <div data-kid=\"183\">\n        <p class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--text-muted)]/60 mb-4 px-2\" data-kid=\"184\">Key Entities Identified</p>\n        <div class=\"space-y-3\" data-kid=\"185\">\n          \n          <div class=\"glass-heavy p-4 rounded-2xl border-l-4 border-[var(--accent)] shadow-sm hover:translate-x-1 hover:shadow-md transition-all cursor-pointer group/node\" data-kid=\"186\">\n            <div class=\"flex items-center justify-between mb-2\" data-kid=\"187\">\n              <div class=\"flex items-center gap-2\" data-kid=\"188\">\n                <div class=\"p-1.5 rounded-lg bg-[var(--accent)]/10 text-[var(--accent)]\" data-kid=\"189\">\n                  <i class=\"ti ti-share-2 text-sm\" data-kid=\"190\"></i>\n                </div>\n                <span class=\"text-xs font-bold text-[var(--text-primary)] group-hover/node:text-[var(--accent)] transition-colors\" data-kid=\"191\">Project Orion</span>\n              </div>\n              <span class=\"text-[9px] font-bold text-amber-500 bg-amber-50 px-1.5 py-0.5 rounded border border-amber-500/10 shadow-sm\" data-kid=\"192\">CORE NODE</span>\n            </div>\n            <p class=\"text-[11px] text-[var(--text-muted)] leading-relaxed mb-3\" data-kid=\"193\">Central project node with 48 associated documents and 14 team members.</p>\n            <div class=\"flex -space-x-1.5\" data-kid=\"194\">\n              <img src=\"https://i.pravatar.cc/100?u=1\" class=\"w-5 h-5 rounded-full border border-white\" data-kid=\"195\">\n              <img src=\"https://i.pravatar.cc/100?u=2\" class=\"w-5 h-5 rounded-full border border-white\" data-kid=\"196\">\n              <img src=\"https://i.pravatar.cc/100?u=3\" class=\"w-5 h-5 rounded-full border border-white\" data-kid=\"197\">\n              <div class=\"w-5 h-5 rounded-full border border-white bg-gray-100 flex items-center justify-center text-[8px] font-bold text-gray-500\" data-kid=\"198\">+11</div>\n            </div>\n          </div>\n\n          \n          <div class=\"glass-heavy p-4 rounded-2xl border-l-4 border-blue-400 shadow-sm hover:translate-x-1 transition-transform cursor-pointer\" data-kid=\"199\">\n            <div class=\"flex items-center justify-between mb-2\" data-kid=\"200\">\n              <div class=\"flex items-center gap-2\" data-kid=\"201\">\n                <div class=\"p-1.5 rounded-lg bg-blue-100 text-blue-500\" data-kid=\"202\">\n                  <i class=\"ti ti-database text-sm\" data-kid=\"203\"></i>\n                </div>\n                <span class=\"text-xs font-bold text-[var(--text-primary)]\" data-kid=\"204\">Node-7x Cluster</span>\n              </div>\n            </div>\n            <p class=\"text-[11px] text-[var(--text-muted)] leading-relaxed\" data-kid=\"205\">Infrastructure asset tagged in 3 recent incident reports. High risk of failure.</p>\n          </div>\n        </div>\n      </div>\n\n      <div data-kid=\"206\">\n        <p class=\"text-[10px] font-bold uppercase tracking-widest text-[var(--text-muted)]/60 mb-4 px-2\" data-kid=\"207\">Contextual Intelligence</p>\n        <div class=\"space-y-3\" data-kid=\"208\">\n          <div class=\"group bg-white/40 border border-white/60 p-4 rounded-2xl hover:bg-white/80 transition-all cursor-default\" data-kid=\"209\">\n            <div class=\"flex gap-3\" data-kid=\"210\">\n              <div class=\"w-1.5 h-1.5 rounded-full bg-[var(--accent)] mt-1.5 shrink-0 shadow-[0_0_8px_rgba(108,92,231,0.6)]\" data-kid=\"211\"></div>\n              <div data-kid=\"212\">\n                <p class=\"text-xs font-bold text-[var(--text-primary)] mb-1\" data-kid=\"213\">Unusual Pattern Detected</p>\n                <p class=\"text-[11px] text-[var(--text-muted)] leading-snug\" data-kid=\"214\">Multiple team members are searching for 'Cloud-Burst' pricing simultaneously across 4 channels.</p>\n              </div>\n            </div>\n          </div>\n          <div class=\"group bg-white/40 border border-white/60 p-4 rounded-2xl hover:bg-white/80 transition-all cursor-default\" data-kid=\"215\">\n            <div class=\"flex gap-3\" data-kid=\"216\">\n              <div class=\"w-1.5 h-1.5 rounded-full bg-emerald-500 mt-1.5 shrink-0 shadow-[0_0_8px_rgba(16,185,129,0.6)]\" data-kid=\"217\"></div>\n              <div data-kid=\"218\">\n                <p class=\"text-xs font-bold text-[var(--text-primary)] mb-1\" data-kid=\"219\">Knowledge Gap Filled</p>\n                <p class=\"text-[11px] text-[var(--text-muted)] leading-snug\" data-kid=\"220\">New documentation for v2.4 API hooks has been indexed from the dev repository. <span class=\"text-[var(--accent)] font-bold\" data-kid=\"221\">View Diff</span></p>\n              </div>\n            </div>\n          </div>\n        </div>\n      </div>\n    </div>\n\n    <div class=\"p-8\" data-kid=\"222\">\n      <div class=\"bg-white/60 border border-white p-4 rounded-2xl flex items-center justify-between shadow-sm hover:bg-white/80 transition-all cursor-pointer\" data-kid=\"223\">\n        <div class=\"flex items-center gap-3\" data-kid=\"224\">\n          <div class=\"relative\" data-kid=\"225\">\n            <i class=\"ti ti-topology-star-3 text-2xl text-[var(--accent)]\" data-kid=\"226\"></i>\n            <span class=\"absolute -top-1 -right-1 flex h-2 w-2 rounded-full bg-[var(--accent)]\" data-kid=\"227\"></span>\n          </div>\n          <div data-kid=\"228\">\n            <p class=\"text-xs font-bold text-[var(--text-primary)]\" data-kid=\"229\">Graph Health</p>\n            <p class=\"text-[10px] text-emerald-600 font-bold uppercase\" data-kid=\"230\">Optimized</p>\n          </div>\n        </div>\n        <button class=\"px-3 py-1.5 bg-white border border-gray-100 rounded-lg shadow-sm text-[10px] font-bold hover:bg-gray-50 transition-all\" data-kid=\"231\">REFRESH</button>\n      </div>\n    </div>\n  </aside>\n</div>\n",
