=\"38\">\n                        <div class=\"w-16 h-16 bg-white rounded-2xl flex items-center justify-center shadow-sm border border-white/50\" data-kid=\"39\">\n                            <i class=\"ti ti-database-heart text-3xl text-[var(--accent-violet)]\" data-kid=\"40\"></i>\n                        </div>\n                        <div class=\"flex items-center gap-2 px-3 py-1.5 bg-emerald-500/10 rounded-full border border-emerald-500/25 shadow-sm\" data-kid=\"41\">\n                            <span class=\"w-2 h-2 rounded-full bg-emerald-500 status-dot\" data-kid=\"42\"></span>\n                            <span class=\"text-[10px] font-bold text-emerald-700 uppercase tracking-wider\" data-kid=\"43\">Live Connection</span>\n                        </div>\n                    </div>\n                    <h3 class=\"text-2xl font-bold mb-1\" data-kid=\"44\">VectorDB Edge</h3>\n                    <p class=\"text-xs font-mono text-[#7a7a95] mb-6\" data-kid=\"45\">mcp://localhost:4002/pinecone-prod</p>\n                    \n                    <div class=\"space-y-4 pt-6 border-t border-white/40\" data-kid=\"46\">\n                        <div class=\"flex justify-between items-center\" data-kid=\"47\">\n                            <span class=\"text-[10px] font-bold text-[#b0b0c8] uppercase\" data-kid=\"48\">Sync Latency</span>\n                            <span class=\"text-sm font-mono font-semibold text-[#3d3d55]\" data-kid=\"49\">4.2ms</span>\n                        </div>\n                        <div class=\"flex justify-between items-center\" data-kid=\"50\">\n                            <span class=\"text-[10px] font-bold text-[#b0b0c8] uppercase\" data-kid=\"51\">Active Tools</span>\n                            <span class=\"text-sm font-mono font-semibold text-[#3d3d55]\" data-kid=\"52\">14 Units</span>\n                        </div>\n                        <div class=\"flex justify-between items-center\" data-kid=\"53\">\n                      