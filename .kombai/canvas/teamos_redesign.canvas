ace-nowrap\" data-kid=\"85\">\n            <span class=\"text-[10px] font-mono bg-[#1c1c28] border border-white/10 px-2 py-1 rounded text-white/80\" data-kid=\"86\">Vector Store A</span>\n          </div>\n        </div>\n\n        <div class=\"absolute top-[320px] left-[420px] animate-float group cursor-pointer z-20\" style=\"animation-delay: -2s;\" data-kid=\"87\">\n          <div class=\"w-14 h-14 rounded-2xl bg-[#1c1c28]/80 backdrop-blur-md border border-white/10 flex items-center justify-center hover:border-[#8b7ff4] transition-all group-hover:shadow-[0_0_30px_rgba(139,127,244,0.3)] group-hover:scale-110\" data-kid=\"88\">\n            <i class=\"ti ti-api text-white/40 group-hover:text-[#8b7ff4] text-2xl\" data-kid=\"89\"></i>\n          </div>\n          <div class=\"absolute -top-10 left-1/2 -translate-x-1/2 opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap\" data-kid=\"90\">\n            <span class=\"text-[10px] font-mono bg-[#1c1c28] border border-white/10 px-2 py-1 rounded text-white/80\" data-kid=\"91\">Inference Gateway</span>\n          </div>\n        </div>\n      </div>\n\n      \n      <div class=\"p-8 relative z-20 space-y-4\" data-kid=\"92\">\n        <div class=\"bg-[#1c1c28]/60 backdrop-blur-xl border border-white/10 rounded-2xl p-6\" data-kid=\"93\">\n          <div class=\"flex items-center justify-between mb-4\" data-kid=\"94\">\n            <span class=\"text-[10px] font-mono text-white/40 uppercase tracking-widest\" data-kid=\"95\">Network Stability</span>\n            <span class=\"text-[10px] font-mono text-[#8b7ff4]\" data-kid=\"96\">98.2%</span>\n          </div>\n          <div class=\"h-1 w-full bg-white/5 rounded-full overflow-hidden\" data-kid=\"97\">\n            <div class=\"h-full bg-[#8b7ff4] shadow-[0_0_10px_#8b7ff4]\" style=\"width: 98.2%;\" data-kid=\"98\"></div>\n          </div>\n        </div>\n        <div class=\"flex gap-2\" data-kid=\"99\">\n          <button class=\"flex-1 h-12 bg-white/5 hover: