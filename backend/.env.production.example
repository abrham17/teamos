# TeamOS Backend - Production Environment Template

# Core Django
DJANGO_SECRET_KEY=your_super_secret_key_here
DJANGO_ALLOWED_HOSTS=api.teamos.local,teamos-backend.fly.dev
CORS_ALLOWED_ORIGINS=https://teamos.local,https://teamos-frontend.vercel.app
FRONTEND_URL=https://teamos-frontend.vercel.app
DEFAULT_FROM_EMAIL=noreply@teamos.local

# Database (Supabase / Postgres)
DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Redis (Upstash / Local)
REDIS_URL=redis://default:password@hostname:6379

# Qdrant Vector DB
QDRANT_URL=https://your-qdrant-cluster.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key

# LLMs
OPENAI_API_KEY=sk-proj-your_openai_key
# All chat/planning calls go through OpenRouter → DeepSeek V4.
# Embeddings use OpenAI directly.
# Optional: OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# Optional RAG limits (see teamos_project.settings.production defaults)
# CHAT_RAG_MAX_CONTEXT_CHARS=100000
# CHAT_RAG_RESULT_LIMIT=30
# Optional: chat voice playback (defaults shown)
# OPENAI_TTS_MODEL=tts-1
# OPENAI_TTS_DEFAULT_VOICE=alloy

# Clerk JWT verification
CLERK_ISSUER=https://your-clerk-instance.clerk.accounts.dev
CLERK_JWKS_URL=https://your-clerk-instance.clerk.accounts.dev/.well-known/jwks.json
CLERK_AUDIENCE=your_api_audience

# Google OAuth (Optional)
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
# Backward-compatible aliases (either pair works in settings)
GOOGLE_OAUTH_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_OAUTH_SECRET=your_client_secret

# Billing
BILLING_PROVIDER=paddle
PADDLE_WEBHOOK_SECRET=your_paddle_webhook_secret
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300
# Paddle Billing (live checkout when all three are set; otherwise dev uses stub checkout URL)
PADDLE_API_KEY=
PADDLE_API_BASE=https://sandbox-api.paddle.com
PADDLE_PRICE_ID_TEAM=
PADDLE_PRICE_ID_PRO=
PADDLE_PRICE_ID_ENTERPRISE=
# Optional: set true only for Paddle dashboard preview links
# PADDLE_CHECKOUT_PREVIEW=true
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# Team lifecycle
TEAM_SOFT_DELETE_GRACE_HOURS=24

# ── Observability (LangSmith) ─────────────────────────────────────────────────
# Traces all LLM calls, agent loops, and planning graph nodes.
# Get your key at: https://smith.langchain.com → Settings → API Keys
LANGSMITH_API_KEY=your_langsmith_api_key
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT="teamos"
# Set to false to disable tracing without removing the key
LANGSMITH_TRACING=true

# ── LangGraph Planning Engine ─────────────────────────────────────────────────
# Feature flag: routes Pro/Enterprise planning runs through the LangGraph graph.
# Set to false to keep all users on the legacy synchronous pipeline.
PLANNING_USE_LANGGRAPH=true

# ── Dynamic Crew Factory ──────────────────────────────────────────────────────
# Routes high-complexity, multi-domain chat prompts through a LangGraph crew.
CHAT_USE_CREW_FACTORY=true